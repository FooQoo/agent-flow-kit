{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*afk__(record_request|open_plan|update_plan|update_question|start_next|finish_task)",
        "hooks": [
          {
            "type": "command",
            "command": "\"/bin/sh\" \"${CLAUDE_PLUGIN_ROOT}/run\" --hook",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/bin/sh\" \"${CLAUDE_PLUGIN_ROOT}/run\" --hook",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/bin/sh\" \"${CLAUDE_PLUGIN_ROOT}/run\" --hook",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
